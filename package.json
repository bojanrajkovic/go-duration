{
  "name": "@bojanrajkovic/go-duration",
  "version": "0.0.0",
  "description": "Go's time.ParseDuration and Duration.String for Temporal.Duration",
  "keywords": [
    "duration",
    "go",
    "golang",
    "parse",
    "temporal",
    "time"
  ],
  "license": "MIT",
  "author": "Bojan Rajkovic",
  "repository": {
    "type": "git",
    "url": "https://github.com/bojanrajkovic/go-duration.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "test": "vitest run --typecheck",
    "lint": "oxlint",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "devDependencies": {
    "@tsconfig/node26": "26.0.1",
    "@tsconfig/strictest": "2.0.8",
    "@types/node": "26.6.5",
    "fast-check": "4.10.2",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "temporal-polyfill": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "temporal-polyfill": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=26"
  }
}
